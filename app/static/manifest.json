{
  "name": "{{ empresa.nome if empresa else 'Vortice Gestão' }}",
  "short_name": "{{ (empresa.nome.split(' ')[0] ~ ' App') if empresa else 'Vortice App' }}",
  "description": "Sistema Integrado de Gestão Operacional e RH",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "{{ (empresa.config_json.get('cor_primaria', '#0f172a')) if empresa and empresa.config_json else '#0f172a' }}",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "{{ (empresa.config_json.get('logo_url', '/static/icons/icon-192x192.png')) if empresa and empresa.config_json else '/static/icons/icon-192x192.png' }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{{ (empresa.config_json.get('logo_url', '/static/icons/icon-512x512.png')) if empresa and empresa.config_json else '/static/icons/icon-512x512.png' }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}



